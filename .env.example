# Copy to .env and fill in. Never commit .env.
# ---- Claude (Anthropic): the only required value
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
EXTRACTOR_MODEL=claude-haiku-5-5
KG_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
GENERATOR_MODEL=claude-haiku-5-5
# hard spending cap in USD across all runs (estimated at list prices); stops a run before it overspends
EPISTEME_BUDGET_USD=4.5
# ---- optional: OpenAI (only needed to call gpt-* models)
OPENAI_API_KEY=
# ---- Neo4j AuraDB (optional: without it the local mirror is used)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# ---- public hosting (optional)
EPISTEME_PUBLIC_MODE=0
EPISTEME_ADMIN_TOKEN=
